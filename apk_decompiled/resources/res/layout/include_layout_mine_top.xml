<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/circle_imageView"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginTop="65dp"
        android:src="@mipmap/default_avator"/>
    <xfkj.fitpro.view.RxRunTextView
        android:textSize="16sp"
        android:textColor="#071427"
        android:id="@+id/tv_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="8dp"
        android:text="@string/app_name"
        android:layout_toRightOf="@+id/circle_imageView"
        android:layout_alignTop="@+id/circle_imageView"
        style="@style/textview_marquee_style"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#acabaf"
        android:gravity="left"
        android:id="@+id/tv_user_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:minWidth="78dp"
        android:text="ID:N/A"
        android:layout_toRightOf="@+id/circle_imageView"
        android:layout_below="@+id/tv_user_name"
        android:layout_alignLeft="@+id/tv_user_name"/>
</merge>
