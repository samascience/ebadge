<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolbar"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:id="@+id/toolbar_back"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/img_back"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/outline_return"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <xfkj.fitpro.view.RxRunTextView
        android:textSize="19sp"
        android:textColor="#071427"
        android:layout_gravity="center_horizontal"
        android:id="@+id/toolbar_title"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:maxWidth="150dp"
        style="@style/textview_marquee_style"/>
    <ImageView
        android:layout_gravity="left"
        android:id="@+id/img_left"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_15"/>
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/img_right"
        android:padding="@dimen/dp_6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_20"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="15sp"
        android:layout_gravity="right"
        android:id="@+id/btn_right"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginRight="@dimen/dp_20"
        android:text="@string/finish"
        style="@style/yellow_around_btn_style"/>
    <ImageButton
        android:id="@+id/img_btn_right"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/home_hh_add_icon"
        style="@style/include_title_right_style"/>
    <TextView
        android:textSize="17sp"
        android:textColor="#838287"
        android:id="@+id/tv_finish"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/finish"
        style="@style/include_title_right_style"/>
</androidx.appcompat.widget.Toolbar>
