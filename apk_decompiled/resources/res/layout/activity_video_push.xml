<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_video_push_0"
    android:background="0x7f0800ff"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:id="@+id/iv_video_push_back"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0801f2"
            android:layout_centerVertical="true"
            android:contentDescription="@string/video_push"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_push"/>
    </androidx.appcompat.widget.Toolbar>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/videoPushSwipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/preview_video_container"
                    android:background="@drawable/bg_preview_circle"
                    android:layout_width="200dp"
                    android:layout_height="200dp">
                    <android.widget.VideoView
                        android:id="@+id/iv_video_preview"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/video_push"/>
                    <ImageView
                        android:id="@+id/iv_video_preview_image"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/video_push"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_gravity="center"
                    android:id="@+id/video_crop_size"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text=""/>
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000"
                    android:layout_gravity="center"
                    android:id="@+id/btn_picture_video_upload"
                    android:background="0x7f0801f3"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="15dp"
                    android:text="@string/upload"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:id="@+id/device_remaining_space"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/device_remaining_space_unknown"
                            android:layout_weight="1"/>
                        <androidx.appcompat.widget.AppCompatButton
                            android:textSize="12sp"
                            android:textColor="@color/black"
                            android:id="@+id/refresh_device_space"
                            android:background="@drawable/btn_refresh"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:text="@string/refresh"
                            android:layout_marginStart="20dp"
                            android:stateListAnimator="@null"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_video_prompt"/>
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/rg_video_length"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="12dp">
                        <RadioButton
                            android:textSize="14sp"
                            android:textColor="#000000"
                            android:id="@+id/rb_five_seconds"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/five_seconds"
                            android:layout_weight="1"
                            app:buttonTint="@color/radio_button_tint"/>
                        <RadioButton
                            android:textSize="14sp"
                            android:textColor="#000000"
                            android:id="@+id/rb_ten_seconds"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/ten_seconds"
                            android:layout_weight="1"
                            app:buttonTint="@color/radio_button_tint"/>
                        <RadioButton
                            android:textSize="14sp"
                            android:textColor="#000000"
                            android:id="@+id/rb_fifteen_seconds"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/fifteen_seconds"
                            android:layout_weight="1"
                            app:buttonTint="@color/radio_button_tint"/>
                    </RadioGroup>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upload_quality"/>
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/rg_upload_quality"
                        android:layout_width="match_parent"
                        android:layout_height="40dp">
                        <RadioButton
                            android:textSize="14sp"
                            android:textColor="#000000"
                            android:id="@+id/rb_low_quality"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/low_quality"
                            android:layout_weight="1"
                            app:buttonTint="@color/radio_button_tint"/>
                        <RadioButton
                            android:textSize="14sp"
                            android:textColor="#000000"
                            android:id="@+id/rb_medium_quality"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/medium_quality"
                            android:layout_weight="1"
                            app:buttonTint="@color/radio_button_tint"/>
                        <RadioButton
                            android:textSize="14sp"
                            android:textColor="#000000"
                            android:id="@+id/rb_high_quality"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/high_quality"
                            android:layout_weight="1"
                            app:buttonTint="@color/radio_button_tint"/>
                    </RadioGroup>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_gravity="bottom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="0x7f080234"
                                android:contentDescription="@string/select_video"
                                android:translationY="8dp"/>
                            <TextView
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:layout_gravity="center"
                                android:id="@+id/tv_select_picture"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/select_video"/>
                        </FrameLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">
                            <ImageView
                                android:id="@+id/iv_video"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="0x7f0801f9"
                                android:contentDescription="@string/select_video"/>
                            <ImageView
                                android:id="@+id/iv_select_gif"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="0x7f0801f5"
                                android:contentDescription="@string/select_video"
                                android:layout_marginStart="10dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <FrameLayout
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <ImageView
                            android:layout_gravity="bottom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="0x7f080234"
                            android:contentDescription="@string/select_video"
                            android:translationY="8dp"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:id="@+id/tv_video_capture_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/video_capture_duration"/>
                    </FrameLayout>
                    <androidx.cardview.widget.CardView
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="#bdb0fd"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="0dp">
                        <FrameLayout
                            android:id="@+id/video_trim_container"
                            android:layout_width="match_parent"
                            android:layout_height="120dp">
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/frameRecyclerView"
                                android:scrollbars="horizontal"
                                android:clipToPadding="false"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/video_capture_duration"
                                android:paddingStart="32dp"
                                android:paddingEnd="32dp"/>
                            <androidx.cardview.widget.CardView
                                android:layout_width="200dp"
                                android:layout_height="match_parent"
                                android:layout_margin="10dp"
                                app:cardCornerRadius="25dp"
                                app:cardElevation="0dp">
                                <ImageView
                                    android:layout_gravity="start"
                                    android:id="@+id/handleLeft"
                                    android:background="@android:color/transparent"
                                    android:layout_width="32dp"
                                    android:layout_height="match_parent"
                                    android:src="0x7f080250"
                                    android:contentDescription="@string/video_capture_duration"/>
                                <ImageView
                                    android:layout_gravity="end"
                                    android:id="@+id/handleRight"
                                    android:background="@android:color/transparent"
                                    android:layout_width="32dp"
                                    android:layout_height="match_parent"
                                    android:src="0x7f080251"
                                    android:contentDescription="@string/video_capture_duration"/>
                            </androidx.cardview.widget.CardView>
                            <View
                                android:id="@+id/selectionOverlay"
                                android:background="#330000ff"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
