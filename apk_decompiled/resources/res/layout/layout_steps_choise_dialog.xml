<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_dialog_weight_unite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="#ff2e303b"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/chiose_target_steps"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff59585f"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/arm_steps_label"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/theme_color"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="0"/>
        <com.jdqm.tapelibrary.TapeView
            android:id="@+id/tapeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:bgColor="@color/white"
            app:calibrationColor="#fff0f1f6"
            app:maxValue="20000"
            app:minValue="1000"
            app:per="100"
            app:perCount="1000"
            app:textColor="#ffacabaf"
            app:triangleColor="@color/theme_color"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tv_cancel"
                android:text="@string/cancel"
                style="@style/weight_cancel_confirm_style"/>
            <View
                android:layout_gravity="center_vertical"
                android:background="@color/theme_color"
                android:layout_width="1dp"
                android:layout_height="15dp"/>
            <TextView
                android:id="@+id/tv_ok"
                android:text="@string/ok"
                style="@style/weight_cancel_confirm_style"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
