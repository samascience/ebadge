<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_square_gray"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#000"
            android:id="@+id/tv_log_type"
            android:background="@drawable/shape_round_white"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发送"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#666"
            android:gravity="end"
            android:id="@+id/tv_log_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="20:13:45.123"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="#000"
        android:id="@+id/tv_log_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="协议数据包内容..."/>
    <TextView
        android:textSize="12sp"
        android:textColor="#666"
        android:id="@+id/tv_log_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="模块ID: 0x01, 命令ID: 0x02, 序列号: 123"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#999"
        android:id="@+id/tv_log_hex_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="25 01 01 02 00 7B 01 02 03 04 12 34 56 78 26"
        android:fontFamily="monospace"/>
</LinearLayout>
