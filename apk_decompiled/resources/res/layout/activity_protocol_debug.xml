<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/activity_protocol_debug_0"
    android:background="0x7f0800ff"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:id="@+id/iv_protocol_debug_back"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0801f2"
            android:layout_centerVertical="true"
            android:contentDescription="返回"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="协议调试"/>
    </androidx.appcompat.widget.Toolbar>
    <ScrollView
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_square_gray"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="连接状态"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff0000"
                    android:id="@+id/tv_connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="未连接"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <Button
                        android:textSize="14sp"
                        android:textColor="#fff"
                        android:id="@+id/btn_connect_device"
                        android:background="@drawable/btn_primary_background"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:text="连接设备"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"/>
                    <Button
                        android:enabled="false"
                        android:textSize="14sp"
                        android:textColor="#fff"
                        android:id="@+id/btn_disconnect_device"
                        android:background="@drawable/btn_secondary_background"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:text="断开连接"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_square_gray"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="协议控制"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <Button
                        android:textSize="12sp"
                        android:textColor="#fff"
                        android:id="@+id/btn_send_test_data"
                        android:background="@drawable/btn_primary_background"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:text="发送测试数据"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"/>
                    <Button
                        android:textSize="12sp"
                        android:textColor="#fff"
                        android:id="@+id/btn_request_device_info"
                        android:background="@drawable/btn_primary_background"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:text="设备信息"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"/>
                    <Button
                        android:textSize="12sp"
                        android:textColor="#fff"
                        android:id="@+id/btn_request_media_list"
                        android:background="@drawable/btn_primary_background"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:text="媒体列表"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <Button
                    android:textSize="14sp"
                    android:textColor="#fff"
                    android:id="@+id/btn_clear_logs"
                    android:background="@drawable/btn_secondary_background"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:text="清空日志"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_square_gray"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="协议日志"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_protocol_logs"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress_bar"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
